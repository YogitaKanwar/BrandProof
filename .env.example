BRANDPROOF_DATABASE_URL=sqlite:///./data/brandproof.db
BRANDPROOF_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local HTTP only. Omit this override or set true for HTTPS deployments.
BRANDPROOF_DEMO_COOKIE_SECURE=false
# PostgreSQL option (container/PostgreSQL smoke tested in CI; hosted acceptance pending):
# BRANDPROOF_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/brandproof
# Standard postgres:// and postgresql:// URLs also select psycopg 3 automatically.
# Optional single-origin production UI, after running npm ci && npm run build in frontend:
# BRANDPROOF_FRONTEND_DIST=./frontend/dist
# Optional exact public origin behind TLS termination; Render's RENDER_EXTERNAL_URL
# is detected automatically. Set this explicitly for a custom domain/other host.
# BRANDPROOF_PUBLIC_ORIGIN=https://your-confirmed-host.example
# External AI is OFF by default. Provider/model names must be chosen and tested.
BRANDPROOF_AI_PROVIDER=none
BRANDPROOF_AI_MODEL=
BRANDPROOF_AI_API_KEY=
BRANDPROOF_EXTERNAL_AI_ENABLED=false
# Conservative persistent admission limits; failed reservations also count.
BRANDPROOF_AI_WORKSPACE_HOURLY_LIMIT=6
BRANDPROOF_AI_GLOBAL_HOURLY_LIMIT=24
BRANDPROOF_AI_WORKSPACE_CONCURRENCY_LIMIT=1
BRANDPROOF_AI_GLOBAL_CONCURRENCY_LIMIT=2
# For Groq/OpenRouter set provider to groq/openrouter, model and key SERVER-SIDE.
# Sending data also requires external_ai_consent:true on each POST /reviews.
